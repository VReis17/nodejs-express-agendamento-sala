{
  "openapi": "3.0.3",
  "info": {
    "title": "API de Agendamento de Salas",
    "version": "1.0.0"
  },
  "paths": {
    "/api/salas/disponibilidade": {
      "get": {
        "summary": "Consulta a disponibilidade das salas",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "inicio", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" }, "example": "2026-08-01T14:00:00Z" },
          { "name": "fim", "in": "query", "required": true, "schema": { "type": "string", "format": "date-time" }, "example": "2026-08-01T15:00:00Z" }
        ],
        "responses": {
          "200": {
            "description": "Consulta realizada com sucesso",
            "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/DisponibilidadeSala" } } } }
          },
          "400": { "description": "Intervalo inválido" },
          "401": { "description": "Token inválido, ausente ou expirado" }
        }
      }
    },
    "/api/salas/reserva": {
      "post": {
        "summary": "Reservar uma sala de reunião",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["salaId", "inicio", "fim"],
                "properties": {
                  "salaId": {
                    "type": "integer",
                    "example": 1
                  },
                  "inicio": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-08-01T14:00:00Z"
                  },
                  "fim": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-08-01T15:00:00Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Reserva criada com sucesso",
            "content": {
              "application/json": {
                "example": {
                  "sucesso": true,
                  "data": {
                    "reservaId": 101,
                    "salaId": 1,
                    "funcionarioId": 5,
                    "inicio": "2026-08-01T14:00:00Z",
                    "fim": "2026-08-01T15:00:00Z"
                  },
                  "erro": null
                }
              }
            }
          },
          "400": {
            "description": "Dados de entrada inválidos"
          },
          "401": {
            "description": "Token ausente ou inválido"
          },
          "409": {
            "description": "Conflito de agenda",
            "content": {
              "application/json": {
                "example": {
                  "success": false,
                  "data": null,
                  "erro": [
                    {
                      "code": "ROOM_ALREADY_BOOKED",
                      "menssagem": "A sala já possui uma reserva que conflita com o horário solicitado."
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DisponibilidadeSala": {
        "type": "object",
        "required": ["id", "nome", "disponivel", "reservaDe"],
        "properties": {
          "id": { "type": "string", "example": "sala-1" },
          "nome": { "type": "string", "example": "Sala Java" },
          "disponivel": { "type": "boolean" },
          "reservaDe": { "type": "string", "nullable": true, "example": "Henrique Sousa" }
        }
      }
    }
  }
}